pipeline {
    agent any

    tools {
        maven 'Maven3'
    }

    stages {
        stage('Checkout') {
            steps {
                git 'https://github.com/harisaravananm/DevOpslab_exp.git'
            }
        }

        stage('Maven Build') {
            steps {
                // Windows agent:
                bat 'mvn clean package'
                // Linux agent:
                // sh 'mvn clean package'
            }
        }

        stage('Docker Build') {
            steps {
                // Windows agent:
                bat 'docker build -t devops-hello:latest .'
                // Linux agent:
                // sh 'docker build -t devops-hello:latest .'
            }
        }
    }
}
